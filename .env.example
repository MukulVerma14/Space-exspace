# =============================================================================
# SPACE EXSPACE — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to:
#   1. backend/.env          (for local Node.js / Express development)
#   2. .env                  (in repository root for docker-compose / production)
# Protect real .env files with strict permissions: chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment & Server Mode
# -----------------------------------------------------------------------------
# Options: development | test | production
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# In local development:
#   - Default Docker / standard Postgres port is 5432.
#   - If port 5432 is already occupied by a local system database, use port 5433.
# In Docker Compose production:
#   - DB_HOST=postgres (internal docker network service name)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=space_exspace

# Full connection string (used by node-pg-migrate and database scripts)
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/space_exspace

# -----------------------------------------------------------------------------
# 3. Authentication (JWT)
# -----------------------------------------------------------------------------
# In development, a fallback string is accepted.
# In production, this MUST be at least 32 characters, cryptographically random.
JWT_SECRET=dev_jwt_secret_must_be_changed_in_production_min32chars
JWT_EXPIRES_IN=8h

# -----------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Local development: Vite dev server runs on http://localhost:5173
# Production: Reverse proxy serves frontend & backend on the same origin
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# 5. Production Domain, Ingress & Security (Caddy / HTTPS)
# -----------------------------------------------------------------------------
DOMAIN=app.spaceexspace.com
TLS_EMAIL=admin@spaceexspace.com

# HTTP Strict Transport Security (HSTS)
# Default is 300 seconds for demo/staging. In stable production, raise stepwise:
# 86400 (1d) -> 604800 (1w) -> 31536000 (1y).
# Note: includeSubDomains and preload are disabled by default.
HSTS_MAX_AGE=300

# -----------------------------------------------------------------------------
# 6. Demo Seeding Controls (Production Guard)
# -----------------------------------------------------------------------------
# Seed script refuses to run if NODE_ENV=production unless ALLOW_DEMO_SEED=true.
# In production, passwords must be set here (minimum 8 chars) and never in code.
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# -----------------------------------------------------------------------------
# 7. Off-Site Encrypted Backups (rclone crypt layered over S3)
# -----------------------------------------------------------------------------
RCLONE_REMOTE=s3_backup
RCLONE_BUCKET=space-exspace-backups

# Client-Side Encryption Secrets (NaCl SecretBox XSalsa20-Poly1305)
# NEVER commit real values. Store in environment or root-only file (/etc/space_exspace/backup_crypt.key)
BACKUP_CRYPT_PASSPHRASE=your_offline_crypt_passphrase_here_never_commit
BACKUP_CRYPT_SALT=your_offline_crypt_salt_here_never_commit
