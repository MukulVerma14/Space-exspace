# =============================================================================
# SPACE EXSPACE Production Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and configure secrets before launching containers.
# Protect .env with strict file permissions: chmod 600 .env
# =============================================================================

# Server & Ingress
NODE_ENV=production
PORT=3000
DOMAIN=app.spaceexspace.com
TLS_EMAIL=admin@spaceexspace.com

# HTTP Strict Transport Security (HSTS)
# Default 300s for demo/staging. In stable production, raise stepwise: 86400 (1d) -> 604800 (1w) -> 31536000 (1y).
HSTS_MAX_AGE=300

# PostgreSQL Credentials
DB_HOST=postgres
DB_PORT=5432
DB_USER=space_admin
DB_PASSWORD=your_strong_postgres_password_here
DB_NAME=space_exspace

# Authentication
# Must be at least 32 characters, cryptographically random in production
JWT_SECRET=your_production_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=8h

# CORS (matches same-origin domain)
CORS_ORIGIN=https://app.spaceexspace.com

# Demo Seeding Controls (Production Safety Guard)
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Off-Site Encrypted Backup Configuration (rclone crypt layered over S3)
RCLONE_REMOTE=s3_backup
RCLONE_BUCKET=space-exspace-backups

# Client-Side Encryption Secrets (NaCl SecretBox XSalsa20-Poly1305)
# NEVER commit real values. Store in environment or root-only file (/etc/space_exspace/backup_crypt.key)
BACKUP_CRYPT_PASSPHRASE=your_offline_crypt_passphrase_here_never_commit
BACKUP_CRYPT_SALT=your_offline_crypt_salt_here_never_commit
