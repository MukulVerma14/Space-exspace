# =============================================================================
# SPACE EXSPACE Backend Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env
# =============================================================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL 16)
# Default port is 5432; if using an alternative instance or port, update DB_PORT and DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=space_exspace

# Full connection string (used by node-pg-migrate)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/space_exspace

# Authentication
# In production, must be at least 32 characters, cryptographically random
JWT_SECRET=dev_jwt_secret_must_be_changed_in_production_min32chars
JWT_EXPIRES_IN=8h

# CORS
# In local development, points to the Vite frontend server
CORS_ORIGIN=http://localhost:5173

# Demo Seeding Controls (Production Guard)
ALLOW_DEMO_SEED=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=

# Production Domain & TLS
DOMAIN=app.spaceexspace.com
TLS_EMAIL=admin@spaceexspace.com

# HTTP Strict Transport Security (HSTS)
# Default is 300 seconds for demo. In stable production, raise stepwise: 86400 (1d), 604800 (1w), 31536000 (1y).
HSTS_MAX_AGE=300

# Off-Site Encrypted Backup Configuration (rclone crypt layered over S3)
RCLONE_REMOTE=s3_backup
RCLONE_BUCKET=space-exspace-backups

# Client-Side Encryption (NaCl SecretBox XSalsa20-Poly1305)
# NEVER commit real values. Supply via environment variables or root-only file (/etc/space_exspace/backup_crypt.key)
BACKUP_CRYPT_PASSPHRASE=your_offline_crypt_passphrase_here_never_commit
BACKUP_CRYPT_SALT=your_offline_crypt_salt_here_never_commit
